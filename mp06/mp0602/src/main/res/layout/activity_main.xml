<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical">
    

    <TextView
    

        android:layout_width="match_parent"
    

        android:layout_height="wrap_content"
    

        android:text="@string/title"
    

        android:textColor="#709D3C"
    

        android:textStyle="bold|italic"
    

        android:textSize="20sp"
    

        android:layout_marginBottom="24dp"/>
    

    <ImageView
    

        android:layout_width="match_parent"
    

        android:layout_height="130dp"
    

        android:src="@drawable/bg"
    

        android:scaleType="fitCenter"
    

        android:contentDescription="@string/picture"/>
    

    <LinearLayout
    

        android:layout_width="match_parent"
    

        android:layout_height="wrap_content"
    

        android:orientation="horizontal"
    

        android:gravity="center"
    

        android:layout_marginTop="24dp">
        

        <ImageButton
        

            android:id="@+id/greater"
        

            android:layout_width="72dp"
        

            android:layout_height="72dp"
        

            android:layout_margin="8dp"
        

            android:padding="4dp"
        

            android:background="?android:attr/selectableItemBackgroundBorderless"
        

            android:src="@drawable/btn1m"
        

            android:scaleType="fitCenter"
        

            android:contentDescription="@string/greater"/>
        <ImageButton
            android:id="@+id/less"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/btn2m"
            android:scaleType="fitCenter"
            android:contentDescription="@string/less"/>
        <ImageButton
            android:id="@+id/equal"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/btn3m"
            android:scaleType="fitCenter"
            android:contentDescription="@string/equal"/>
        

    </LinearLayout>
</LinearLayout>
