<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_text"
        android:textColor="#709D3C"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/diceLeft"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/dice1"
        android:contentDescription="@string/diceleft_contentdescription"
        app:layout_constraintWidth_max="120dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/diceRight"
        app:layout_constraintTop_toBottomOf="@id/title"/>
    <ImageView
        android:id="@+id/diceRight"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/dice2"
        android:contentDescription="@string/diceright_contentdescription"
        app:layout_constraintWidth_max="120dp"
        app:layout_constraintStart_toEndOf="@id/diceLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/diceLeft"/>
    <EditText
        android:id="@+id/answer"
        android:layout_width="120dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:hint="@string/answer_hint"
        android:contentDescription="@string/answer_contentdescription"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="2"
        android:selectAllOnFocus="true"
        app:layout_constraintTop_toBottomOf="@id/diceLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:importantForAutofill="no"/>
    <Button
        android:id="@+id/check"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/check_text"
        android:backgroundTint="#1CB6C9"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/answer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
